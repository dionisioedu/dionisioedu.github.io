---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import EditorialTheme from '../components/EditorialTheme.astro';
import SiteNav from '../components/SiteNav.astro';
import EditorialHome from '../components/EditorialHome.astro';
import '../styles/editorial.css';
const title = 'Dionisio — C++, systems and ideas';
const description = 'C++, performance and the decisions that make systems better. Articles, practical examples and learning paths by Eduardo Dionisio.';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href="https://dionisio.dev/"/><link rel="alternate" hreflang="en" href="https://dionisio.dev/"/><link rel="alternate" hreflang="pt-BR" href="https://dionisio.dev/pt/"/><link rel="alternate" hreflang="x-default" href="https://dionisio.dev/"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content="https://dionisio.dev/"/><meta property="og:image" content="https://dionisio.dev/assets/images/social-card.png"/><meta property="og:image:alt" content="Dionisio Developer"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://dionisio.dev/assets/images/social-card.png"/><link rel="icon" href="/favicon.ico"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="alternate" type="application/rss+xml" title="Dionisio — English" href="/rss.xml"/><EditorialTheme/><GoogleAnalytics/><script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Eduardo Dionisio',url:'https://dionisio.dev',jobTitle:'C++ Software Developer & AI Engineer',sameAs:['https://github.com/dionisioedu','https://www.linkedin.com/in/dionisiodev/']})}/></head><body class="ed-standalone"><a class="ed-skip-link" href="#main-content">Skip to content</a><header class="ed-site-header"><SiteNav locale="en" alternateHref="/pt/"/></header><main id="main-content" tabindex="-1"><EditorialHome locale="en"/></main></body></html>
