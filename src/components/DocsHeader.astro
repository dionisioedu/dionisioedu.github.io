---
import { getCollection } from 'astro:content';
import SiteNav from './SiteNav.astro';
import { alternatePage } from '../utils/navigation.mjs';
const docs = await getCollection('docs');
const alternate = alternatePage(Astro.url.pathname, docs.map((entry) => entry.id));
---
<SiteNav locale={alternate.locale as 'pt' | 'en'} alternateHref={alternate.href} translated={alternate.translated} />
