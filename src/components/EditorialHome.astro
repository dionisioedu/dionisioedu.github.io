---
import { getCollection } from 'astro:content';
import { getLocalizedBlogPosts, formatBlogDate } from '../utils/blog';
import Newsletter from './Newsletter.astro';
import MentoriaHighlight from './MentoriaHighlight.astro';
import EditorialSketch from './EditorialSketch.astro';
import EditorialEnhancements from './EditorialEnhancements.astro';
interface Props { locale: 'pt' | 'en' }
const { locale } = Astro.props;
const pt = locale === 'pt';
const t = (a: string,b: string) => pt ? a : b;
const posts = getLocalizedBlogPosts(await getCollection('docs'),locale);
const featured = posts[0];
const selected = posts.slice(1,5);
const path = (slug: string) => `/${locale}/artigos-tecnicos/${slug}/`;
const topics = [
  {name:'C++',tag:'c',text:t('Da linguagem às decisões de projeto.','From language features to design decisions.')},
  {name:'Performance',tag:'performance',text:t('Entre o código e o silício.','Between code and silicon.')},
  {name:t('IA aplicada','Applied AI'),tag:t('ia','ai'),text:t('Modelos, ferramentas e o mundo real.','Models, tools and the real world.')},
];
---
<div class="ed-home not-content" id="_top" tabindex="-1">
  <section class="ed-masthead" aria-labelledby="editorial-title">
    <div class="ed-edition"><span>{t('Um caderno sobre engenharia de software','A notebook on software engineering')}</span><span>C++ / SYSTEMS / IDEAS</span></div>
    <div class="ed-masthead-grid"><h1 id="editorial-title">{t('Entender antes','Understand first.')}<br/><em>{t('de otimizar.','Optimize second.')}</em><svg class="ed-underline" viewBox="0 0 600 20" aria-hidden="true"><path d="M3 13 Q180 0 370 9 T596 7"/></svg></h1><div class="ed-intro"><span class="ed-small-cross" aria-hidden="true">✳</span><p>{t('C++, performance e as decisões que tornam sistemas melhores. Para quem está começando — e para quem nunca deixou de perguntar por quê.','C++, performance and the decisions that make systems better. For those getting started — and those who never stopped asking why.')}</p><a class="ed-text-link" href="#leituras">{t('Encontre sua próxima leitura','Find your next read')} <span aria-hidden="true">↓</span></a></div></div>
    <div class="ed-byline"><span>{t('Por','By')} <a href={`/${locale}/about/`}>Eduardo Dionisio Fernandes</a></span><span>{t('Escrito no Brasil. Compartilhado com o mundo.','Written in Brazil. Shared with the world.')}</span></div>
  </section>
  {featured && <section class="ed-lead ed-reveal" aria-label={t('Em destaque','Featured')}>
    <article class="ed-feature"><a href={featured.href} class="ed-cover-link"><img src={featured.cover || '/assets/images/social-card.png'} alt={featured.coverAlt} width="1200" height="630" fetchpriority="high"/><span class="ed-cover-caption">01 / {t('EM DESTAQUE','FEATURED')} <span aria-hidden="true">↗</span></span></a><p class="ed-meta"><time datetime={featured.publishedAt?.toISOString()}>{formatBlogDate(featured.publishedAt,locale)}</time> · {featured.readingTime} {t('min de leitura','min read')}</p><h2><a href={featured.href}>{featured.title}</a></h2><p>{featured.description || featured.excerpt}</p><a class="ed-text-link" href={featured.href}>{t('Ler o artigo','Read the article')} <span aria-hidden="true">↗</span></a></article>
    <aside class="ed-author-note"><span class="ed-eyebrow">{t('À margem do código','In the margins of code')}</span><span class="ed-quote-mark" aria-hidden="true">“</span><blockquote>{t('O código é só o começo. O que importa é entender por que ele funciona — e quando deixa de funcionar.','Code is only the beginning. What matters is understanding why it works — and when it stops working.')}</blockquote><span class="ed-signature">Eduardo Dionisio</span><div class="ed-note-bottom"><span>20+</span><p>{t('anos construindo software, do embarcado aos sistemas de trading.','years building software, from embedded to trading systems.')}</p></div><a class="ed-text-link" href={`/${locale}/about/`}>{t('Conheça o autor','Meet the author')} ↗</a></aside>
  </section>}
  <section class="ed-readings ed-reveal" id="leituras"><div class="ed-section-heading"><div><span class="ed-eyebrow">{t('Ideias que merecem tempo','Ideas worth your time')}</span><h2>{t('No caderno.','From the notebook.')}</h2></div><a class="ed-text-link" href={`/${locale}/artigos-tecnicos/`}>{t('Todo o acervo','Full archive')} ↗</a></div><div class="ed-article-list">{selected.map((post,i)=><article class="ed-article-row"><span class="ed-number">{String(i+2).padStart(2,'0')}</span><div><p class="ed-meta">{post.tags[0]?.label || 'Software'} · {post.readingTime} min</p><h3><a href={post.href}>{post.title}</a></h3><p class="ed-row-excerpt">{post.description || post.excerpt}</p></div>{post.cover && <a class="ed-row-image" href={post.href} aria-label={post.title}><img src={post.cover} alt="" width="240" height="140" loading="lazy"/></a>}<a class="ed-row-arrow" href={post.href} aria-label={`${t('Ler','Read')}: ${post.title}`}>↗</a></article>)}</div></section>
  <section class="ed-lab ed-reveal"><div><span class="ed-eyebrow">{t('Uma ideia, em movimento','An idea, in motion')}</span><h2>{t('Ver também é','Seeing is also')}<br/><em>{t('compreender.','understanding.')}</em></h2><p>{t('Concorrência organiza o progresso. Paralelismo permite trabalho simultâneo. Explore a diferença no desenho — e depois, no código.','Concurrency organizes progress. Parallelism allows simultaneous work. Explore the difference in the drawing — then in the code.')}</p><a class="ed-text-link" href={path('paralelismo-vs-concorrencia')}>{t('Da ideia ao C++','From the idea to C++')} ↗</a></div><EditorialSketch locale={locale}/></section>
  <section class="ed-topics ed-reveal"><div class="ed-section-heading"><div><span class="ed-eyebrow">{t('Siga a sua curiosidade','Follow your curiosity')}</span><h2>{t('Assuntos que se conectam.','Connected ideas.')}</h2></div></div><div class="ed-topic-grid">{topics.map((topic,i)=><a href={`/${locale}/artigos-tecnicos/?tag=${topic.tag}`}><span class="ed-topic-index">0{i+1} /</span><h3>{topic.name}</h3><p>{topic.text}</p><span aria-hidden="true">↗</span></a>)}</div></section>
  <section class="ed-trail ed-reveal"><div><span class="ed-eyebrow">{t('Um caminho, não um atalho','A path, not a shortcut')}</span><h2>{t('Aprenda C++','Learn C++')}<br/><em>{t('com direção.','with direction.')}</em></h2><p>{t('Fundamentos, ownership, concorrência e memória. Construa o repertório para decidir melhor.','Fundamentals, ownership, concurrency and memory. Build the knowledge to make better decisions.')}</p><a class="ed-text-link" href={`/${locale}/reference/trilha-cpp/`}>{t('Abrir trilha completa','Open the full learning path')} ↗</a></div><ol>{[['cpp-versoes-features',t('Conheça a linguagem','Know the language')],['paralelismo-vs-concorrencia',t('Pense a execução','Think about execution')],['corrotinas-programacao-assincrona-cpp',t('Entenda as suspensões','Understand suspension')],['cache-affinity',t('Aproxime-se da memória','Get closer to memory')]].map(([slug,label],i)=><li><a href={path(slug)}><span>0{i+1}</span>{label}<span aria-hidden="true">↗</span></a></li>)}</ol></section>
  <section class="ed-resources"><span class="ed-eyebrow">{t('Para continuar construindo','Keep building')}</span><div class="ed-topic-grid"><a href={`/${locale}/artigos-tecnicos/raii/`}><h3>RAII</h3><p>{t('Ownership como parte do tipo.','Ownership as part of the type.')}</p></a><a href={`/${locale}/downloads/`}><h3>Downloads</h3><p>{t('Wallpapers e checklists gratuitos.','Free wallpapers and checklists.')}</p></a><a href={`/${locale}/shop/`}><h3>{t('Materiais e mentoria','Learning resources')}</h3><p>{t('Próximos passos para aprofundar sua prática.','Next steps to deepen your practice.')}</p></a></div></section>
  {pt && <div class="ed-mentoria"><MentoriaHighlight /></div>}
  <section class="ed-letter ed-reveal"><div class="ed-envelope" aria-hidden="true"><svg viewBox="0 0 160 120"><path d="M10 30 80 5l70 25v80H10Z"/><path d="m10 30 70 48 70-48M10 110l53-45m87 45L97 65"/><path d="M35 46V20h90v26"/><path d="M50 32h60M50 44h40"/></svg></div><div><span class="ed-eyebrow">{t('Do caderno para a sua caixa de entrada','From the notebook to your inbox')}</span><h2>{t('Boas ideias merecem','Good ideas deserve')}<br/><em>{t('uma segunda leitura.','a second reading.')}</em></h2><Newsletter locale={locale}/></div></section>
  <footer class="ed-home-footer"><a class="ed-footer-brand" href={pt?'/pt/':'/'}>d.</a><span>© {new Date().getFullYear()} Eduardo Dionisio<br/>{t('Software, com intenção.','Software, with intention.')}</span><nav aria-label={t('Redes e recursos','Social links and resources')}><a href="https://github.com/dionisioedu">GitHub ↗</a><a href="https://www.linkedin.com/in/dionisiodev/">LinkedIn ↗</a><a href={`/${locale}/projects/`}>{t('Projetos','Projects')} ↗</a><a href={pt?'/pt/rss.xml':'/rss.xml'}>RSS ↗</a></nav></footer>
</div>
<EditorialEnhancements locale={locale}/>
